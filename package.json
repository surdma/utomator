{
  "name": "utomator-workspace",
  "private": true,
  "version": "0.1.0",
  "packageManager": "pnpm@10.0.0",
  "workspaces": [
    "apps/frontend",
    "apps/backend"
  ],
  "scripts": {
    "dev": "node scripts/dev-workspace.mjs",
    "dev:frontend": "pnpm --filter @utomator/frontend dev",
    "dev:backend": "pnpm --filter @utomator/backend dev",
    "build": "pnpm -r build",
    "test": "pnpm --filter @utomator/backend test",
    "test:frontend": "pnpm --filter @utomator/frontend test",
    "test:integration": "pnpm --filter @utomator/backend test:integration",
    "lint": "pnpm --filter @utomator/backend lint",
    "typecheck": "pnpm --filter @utomator/backend typecheck && pnpm --filter @utomator/frontend typecheck",
    "build:all": "turbo run build",
    "lint:all": "turbo run lint",
    "typecheck:all": "turbo run typecheck",
    "test:all": "turbo run test",
    "turbo": "turbo"
  },
  "devDependencies": {
    "turbo": "^2.11.10"
  }
}
