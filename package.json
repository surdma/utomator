{
  "name": "utomator-workspace",
  "private": true,
  "packageManager": "pnpm@10.0.0",
  "scripts": {
    "dev": "turbo run dev",
    "dev:frontend": "pnpm --filter @utomator/frontend dev",
    "dev:backend": "pnpm --filter @utomator/backend dev",
    "dev:automate": "node scripts/dev-automate.mjs",
    "build": "pnpm -r build",
    "build:all": "turbo run build",
    "lint:all": "turbo run lint",
    "typecheck:all": "turbo run typecheck",
    "test:all": "turbo run test",
    "test:backend": "pnpm --filter @utomator/backend test",
    "test:frontend": "pnpm --filter @utomator/frontend test",
    "lint:backend": "pnpm --filter @utomator/backend lint",
    "typecheck:backend": "pnpm --filter @utomator/backend typecheck",
    "format": "prettier --write \"**/*.{ts,tsx,js,jsx,json,md,yml,yaml,css,scss}\"",
    "format:check": "prettier --check \"**/*.{ts,tsx,js,jsx,json,md,yml,yaml,css,scss}\""
  },
  "devDependencies": {
    "prettier": "^3.9.10",
    "prettier-plugin-tailwindcss": "^0.8.1",
    "turbo": "^2.11.10"
  }
}
