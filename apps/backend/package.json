{
  "name": "@utomator/backend",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "tsx watch src/server.ts",
    "start": "node dist/server.js",
    "start:hosted": "node hosted/server.mjs",
    "test:hosted": "vitest run tests/hosted-auth.test.mjs tests/hosted-gateway.test.mjs tests/hosted-worker.test.mjs",
    "build": "tsc -p tsconfig.json",
    "typecheck": "tsc --noEmit -p tsconfig.json",
    "lint": "biome lint --max-diagnostics=200 .",
    "lint:fix": "biome check --write .",
    "test": "vitest run",
    "test:unit": "vitest run",
    "test:feature": "vitest run",
    "test:integration": "vitest run tests/*.integration.test.ts",
    "db:generate": "drizzle-kit generate",
    "db:push": "drizzle-kit push",
    "db:migrate": "drizzle-kit migrate",
    "db:check": "drizzle-kit check",
    "db:studio": "drizzle-kit studio"
  },
  "dependencies": {
    "@fastify/websocket": "^11.3.4",
    "@libsql/client": "^0.18.0",
    "dotenv": "^18.0.9",
    "drizzle-orm": "1.0.0-rc.5",
    "fastify": "^5.0.0",
    "groq-sdk": "^1.6.0",
    "playwright": "^1.55.0",
    "postgres": "3.4.7",
    "typescript": "^5.8.3"
  },
  "devDependencies": {
    "@biomejs/biome": "^2.6.3",
    "@types/node": "^22.0.0",
    "add": "^2.0.9",
    "drizzle-kit": "1.0.0-rc.5",
    "tsx": "^4.23.15",
    "vitest": "^3"
  },
  "engines": {
    "node": ">=22"
  }
}
