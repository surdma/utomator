# The service binds to loopback only. Do not publish it directly to the internet.
PORT=3101
HEADLESS=false
# Utomator automatically joins a running Chrome CDP session at 127.0.0.1:9222.
# If none is available, it reuses the dedicated persistent .runtime/chrome/{platform} profile.
# Optional override for a different loopback port. Unreachable explicit endpoints fail clearly.
# CHROME_CDP_URL=http://127.0.0.1:9333

# Bind Fastify on loopback; the portfolio's /workspace proxy uses this port.
UTOMATOR_PORT=3101
# Without DATABASE_URL use SQLite. Set DATABASE_URL for PostgreSQL.
DB_FILE_NAME=file:local.db
# DATABASE_URL=postgresql://user:password@127.0.0.1:5432/utomator


# Optional, required together to enable authorized LinkedIn Posts API publishing.
# Enable the LinkedIn 'Share on LinkedIn' and 'Sign In with LinkedIn using OpenID Connect' products.
# LINKEDIN_CLIENT_ID=your-linkedin-developer-app-client-id
# LINKEDIN_CLIENT_SECRET=your-linkedin-developer-app-client-secret
# Must exactly match a registered HTTPS redirect URI; forward this callback to /api/linkedin/oauth/callback.
# LINKEDIN_REDIRECT_URI=https://your-secure-domain.example/api/linkedin/oauth/callback
# 32-byte random hex key (64 hex characters). Keep stable, secret, backed up and out of source control.
# LINKEDIN_TOKEN_ENCRYPTION_KEY=64-hex-character-random-key
# LinkedIn's October 2026 Marketing API version, update as LinkedIn releases newer supported versions.
LINKEDIN_API_VERSION=202610
