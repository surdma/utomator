# Host is a single Linux machine with Next.js on 127.0.0.1 and a TLS ingress.
# Copy values into your secret manager rather than committing a populated file.
OIDC_ISSUER=https://identity.example.com
OIDC_CLIENT_ID=configure-with-your-provider
# OIDC_CLIENT_SECRET=configure-with-your-provider
OIDC_REDIRECT_URI=https://automation.example.com/auth/callback
# Generate 32+ bytes of random secret material for each and store separately.
HOSTED_SESSION_SECRET=replace-with-long-random-secret-at-least-32-bytes
HOSTED_OWNER_KEY=replace-with-different-long-random-secret-at-least-32-bytes
HOSTED_TENANT_ROOT=/var/lib/utomator/tenants
NEXT_LOCAL_ORIGIN=http://127.0.0.1:3000
HOSTED_PORT=3200
HOSTED_MAX_WORKERS=20
