{
    "$schema": "https://json.schemastore.org/prettierrc",
    "semi": true,
    "trailingComma": "es5",
    "singleQuote": true,
    "printWidth": 80,
    "tabWidth": 2,
    "useTabs": false,
    "bracketSpacing": true,
    "bracketSameLine": false,
    "arrowParens": "always",
    "endOfLine": "lf",
    "plugins": ["prettier-plugin-tailwindcss"],
    "overrides": [
      {
        "files": ["*.json", "*.json5"],
        "options": {
          "parser": "json",
          "tabWidth": 2
        }
      },
      {
        "files": ["*.md", "*.mdx"],
        "options": {
          "printWidth": 100,
          "proseWrap": "always"
        }
      },
      {
        "files": ["*.yml", "*.yaml"],
        "options": {
          "singleQuote": false,
          "tabWidth": 2
        }
      }
    ]
  }