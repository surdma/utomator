# See https://help.github.com/articles/ignoring-files/ for more about ignoring files.

# dependencies
/node_modules
/.pnp
.pnp.*
.yarn/*
!.yarn/patches
!.yarn/plugins
!.yarn/releases
!.yarn/versions

# testing
/coverage

# next.js
/.next/
/out/

# production
/build

# misc
.DS_Store
*.pem

# debug
npm-debug.log*
yarn-debug.log*
yarn-error.log*
.pnpm-debug.log*

# env files (can opt-in for committing if needed)
.env*

# vercel
.vercel

# turbo
.turbo/

# typescript
*.tsbuildinfo
next-env.d.ts

# automation(linkedin) — generated runtime artifacts (not source)
automation(linkedin)/node_modules/
automation(linkedin)/logs/
automation(linkedin)/screenshots/
automation(linkedin)/state/
automation(linkedin)/server.log
automation(linkedin)/pnpm-lock.yaml

# pnpm workspace and local browser sessions
/apps/frontend/.next/
/apps/frontend/node_modules/
/apps/backend/node_modules/
/apps/backend/dist/
/apps/backend/.runtime/
/workspace/
